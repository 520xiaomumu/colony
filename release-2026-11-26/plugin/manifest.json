{
  "manifest_version": 3,
  "name": "Colony Bridge",
  "version": "0.6.0",
  "version_name": "0.6",
  "description": "Colony 通用浏览器与网络枢纽: 无感免 CORS 转发(含流式)、零黄条静默后台标签与网页模型支持、纯插件 OAuth 回调捕获与临时请求头规则、Chrome tabs/CDP RPC、本机聚合网关(:4135)与端点扫描、通知与自重载。",
  "permissions": [
    "storage",
    "notifications",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "clipboardWrite",
    "cookies",
    "tabs",
    "activeTab",
    "debugger",
    "scripting",
    "userScripts",
    "downloads",
    "history",
    "bookmarks",
    "webNavigation",
    "contextMenus",
    "alarms",
    "tabGroups",
    "sessions",
    "offscreen",
    "contentSettings"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "strip_origin",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "bg.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "cs.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://challenges.cloudflare.com/*"
      ],
      "js": [
        "iframe-hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Colony Bridge"
  },
  "minimum_chrome_version": "120"
}
